# do not use directly. Use //tools/base/build-system:gradle
filegroup(
    name = "gradle-8.12-20241105002153+0000",
    srcs = ["gradle-8.12-20241105002153+0000-bin.zip"],
    visibility = ["//visibility:public"],
)

# The latest SNAPSHOT version of Gradle.

GRADLE_LATEST_SNAPSHOT_VERSION = "8.13-20250221010946+0000"

filegroup(
    name = "gradle-distrib-latest-snapshot",
    srcs = ["gradle-" + GRADLE_LATEST_SNAPSHOT_VERSION + "-bin.zip"],
    visibility = ["//tools/base/build-system:__pkg__"],
)
